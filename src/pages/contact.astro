---
import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import { site } from '../data/site';
import HoursList from '../components/ui/HoursList.astro';

const a = site.address;
const description = 'Contact Lakeside Obstetrics, Gynecology & Fertility in the Inner Richmond, San Francisco. Call 415-741-1000 or visit 402 8th Avenue, Suite 201.';
---
<BaseLayout title={`Contact Us | ${site.shortName}, Inner Richmond, San Francisco`} description={description}>
  <!-- Hero -->
  <section class="section on-dark !pb-20 !pt-40 md:!pt-48" aria-labelledby="ct-h">
    <Backdrop variant="plum" mark="right" />
    <div class="wrap" data-reveal>
      <nav aria-label="Breadcrumb" class="text-[.72rem] font-semibold uppercase tracking-[.2em] text-white/70">
        <a href="/" class="hover:text-rose-200">Home</a>
        <span aria-hidden="true" class="mx-2 text-white/30">/</span>
        <span class="text-rose-200">Contact us</span>
      </nav>
      <h1 id="ct-h" class="mt-8 font-display text-[clamp(2.6rem,6vw,4.8rem)] leading-[1.04] text-white">Contact us</h1>
      <p class="lede mt-6 max-w-2xl">{site.descriptor}</p>
    </div>
  </section>

  <!-- Ways to reach us -->
  <section class="section" aria-labelledby="ct-ways-h">
    <Backdrop variant="blush" mark="none" />
    <div class="wrap">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Our office</p>
        <h2 id="ct-ways-h" class="h-section">{site.shortName}</h2>
        <span class="bio-rule" aria-hidden="true"></span>
        <p class="lede mt-6">The best way to reach us, or to make an appointment, is to call the office.</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <article class="cf-side" data-reveal>
          <p class="eyebrow">Call us</p>
          <p class="mt-4 font-display text-3xl text-plum-900"><a href={site.phoneHref} class="no-underline hover:text-magenta-500">{site.phone}</a></p>
          <p class="mt-3 text-plum-900/80">Call to book an appointment or to ask a question.</p>
          <div class="mt-6"><a href={site.phoneHref} class="btn-appt">Call {site.phone}</a></div>
        </article>

        <article class="cf-side" data-reveal style="--d:.08s">
          <p class="eyebrow">Visit us</p>
          <p class="mt-4 text-lg leading-relaxed text-plum-900">{a.line1}<br />{a.city}, {a.state} {a.zip}</p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a href={site.mapsHref} class="btn-appt" rel="noopener" target="_blank">Get directions</a>
            <a href="/parking" class="btn">Parking information</a>
          </div>
        </article>

        <article class="cf-side" data-reveal style="--d:.16s">
          <p class="eyebrow">Office hours</p>
          <div class="mt-4"><HoursList /></div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

