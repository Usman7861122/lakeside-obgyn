---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import { services } from '../../data/services';
import { genericServices } from '../../data/svc';
import ServicePageGeneric from '../../components/ServicePageGeneric.astro';
import { servicesMenu } from '../../data/nav';
import { site } from '../../data/site';

export function getStaticPaths() {
  return [
    ...services.map((s) => ({ params: { slug: s.slug }, props: { s, g: null } })),
    ...genericServices.map((g) => ({ params: { slug: g.slug }, props: { s: null, g } })),
  ];
}
const { s, g } = Astro.props;
const [photo1, photo2, photo3] = s?.photos ?? [];
const others = servicesMenu.filter((x) => x.href !== `/services/${s?.slug}`);
const ld = s && {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: s.title,
  description: s.metaDescription,
  about: { '@type': 'MedicalProcedure', name: s.menuLabel },
  publisher: { '@type': 'MedicalBusiness', name: site.name, telephone: site.phone },
};
const check = '<path d="m5 12 4.5 4.5L19 7"/>';
---
{g && <ServicePageGeneric g={g} />}
{s && (
<BaseLayout title={`${s.title} | ${site.shortName}, Inner Richmond, San Francisco`} description={s.metaDescription} jsonLd={ld}>
  <!-- Hero -->
  <section class="section on-dark !pb-20 !pt-40 md:!pt-48" aria-labelledby="svc-h">
    <Backdrop variant="plum" mark="right" />
    <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-20">
      <div data-reveal>
        <nav aria-label="Breadcrumb" class="text-[.72rem] font-semibold uppercase tracking-[.2em] text-white/70">
          <a href="/" class="hover:text-rose-200">Home</a>
          <span aria-hidden="true" class="mx-2 text-white/30">/</span>
          <a href="/services" class="hover:text-rose-200">Services</a>
          <span aria-hidden="true" class="mx-2 text-white/30">/</span>
          <span class="text-rose-200">{s.menuLabel}</span>
        </nav>
        <h1 id="svc-h" class="mt-8 font-display text-[clamp(2.4rem,5.4vw,4.4rem)] leading-[1.04] text-white">{s.title}</h1>
        <p class="lede mt-6 max-w-xl">{site.descriptor}</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={site.portalUrl} class="btn-appt" rel="noopener" target="_blank">Request appointment</a>
          <a href={site.phoneHref} class="btn">Call {site.phone}</a>
        </div>
      </div>
      <aside class="hero-card" data-reveal style="--d:.14s" aria-label="Practice details">
        <p class="eyebrow">Visit the practice</p>
        <ul class="mt-6">
          <li class="hero-row">
            <span class="hero-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
            <span><strong>{site.address.line1}</strong><br />{site.address.city}, {site.address.state} {site.address.zip}</span>
          </li>
          <li class="hero-row">
            <span class="hero-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span><strong>Hours</strong><br />{site.hours}</span>
          </li>
          <li class="hero-row">
            <span class="hero-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span>
            <span><strong>Phone</strong><br /><a href={site.phoneHref} class="hover:text-rose-200">{site.phone}</a></span>
          </li>
        </ul>
      </aside>
    </div>
    <div class="wrap mt-16 lg:mt-20" data-reveal>
      <div class="area-strip">
        <span class="area-pin" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
        <p>{site.areaLine}</p>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="section" aria-labelledby="ov-h">
    <Backdrop variant="blush" mark="none" />
    <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <figure class="pframe" data-reveal style="--d:.12s">
        <span class="pframe-line" aria-hidden="true"></span>
        <div class="pframe-img">
          <img src={photo1.src} alt={photo1.alt} width="1400" height="1400" loading="lazy" class="kb h-full w-full object-cover" />
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent"></div>
        </div>
      </figure>
      <div data-reveal>
        <p class="eyebrow">{s.menuLabel}</p>
        <h2 id="ov-h" class="h-section">Book your annual visit</h2>
        <span class="bio-rule" aria-hidden="true"></span>
        <p class="bio-lede mt-9">{s.intro}</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={site.portalUrl} class="btn-appt" rel="noopener" target="_blank">Request appointment</a>
          <a href={site.phoneHref} class="btn !border-plum-700/40 !text-plum-700 hover:!bg-plum-700 hover:!text-white">Call {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Q1: why it is important -->
  <section class="section" aria-labelledby="why-h">
    <Backdrop variant="mist" mark="none" />
    <div class="wrap grid items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <div class="lg:sticky lg:top-28" data-reveal>
        <p class="eyebrow">Annual Well-Woman Exam Q &amp; A</p>
        <h2 id="why-h" class="h-section">{s.why.q}</h2>
        <span class="bio-rule" aria-hidden="true"></span>
      </div>
      <div data-reveal style="--d:.12s">
        <p class="svc-lead">{s.why.lead}</p>
        <ul class="mt-6 border-t border-plum-700/15">
          {s.why.items.map((it) => (
            <li class="prow prow-solo svc-row"><span class="svc-chk" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></span><span class="prow-text !font-semibold !text-plum-900">{it}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Q2: what to expect -->
  <section class="section" aria-labelledby="exp-h">
    <Backdrop variant="blush" mark="none" />
    <div class="wrap grid items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <div class="lg:sticky lg:top-28">
        <figure class="pframe" data-reveal>
          <span class="pframe-line" aria-hidden="true"></span>
          <div class="pframe-img">
            <img src={photo2.src} alt={photo2.alt} width="1400" height="1400" loading="lazy" class="kb h-full w-full object-cover" />
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-plum-800/35 via-transparent to-magenta-500/10 mix-blend-multiply"></div>
          </div>
        </figure>
      </div>
      <div data-reveal style="--d:.12s">
        <h2 id="exp-h" class="h-section">{s.expect.q}</h2>
        <p class="svc-lead mt-6">{s.expect.lead}</p>
        <ul class="mt-6 border-t border-plum-700/15">
          {s.expect.items.map((it) => (
            <li class="prow prow-solo svc-row"><span class="svc-chk" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></span><span class="prow-text !font-semibold !text-plum-900">{it}</span></li>
          ))}
        </ul>
        <p class="svc-after mt-8">{s.expect.after}</p>
      </div>
    </div>
  </section>

  <!-- Q3: when to start -->
  <section class="section on-dark" aria-labelledby="start-h">
    <Backdrop variant="plum" mark="right" rings={2} />
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">Annual Well-Woman Exam Q &amp; A</p>
        <h2 id="start-h" class="h-section text-white">{s.start.q}</h2>
        <span class="bio-rule" aria-hidden="true"></span>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:gap-8">
        {s.start.cards.map((c, n) => (
          <li class="apc" data-reveal style={`--d:${n * 0.1}s`}>
            <p class="apc-big">{c.label}</p>
            <p class="apc-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Q4: how to prepare -->
  <section class="section" aria-labelledby="prep-h">
    <Backdrop variant="mist" mark="none" />
    <div class="wrap grid items-start gap-12 lg:grid-cols-[7fr_5fr] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">Annual Well-Woman Exam Q &amp; A</p>
        <h2 id="prep-h" class="h-section">{s.prepare.q}</h2>
        <p class="svc-lead mt-6">{s.prepare.lead}</p>
        <ul class="mt-6 border-t border-plum-700/15">
          {s.prepare.items.map((it) => (
            <li class="prow prow-solo svc-row"><span class="svc-chk" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></span><span class="prow-text !font-semibold !text-plum-900">{it}</span></li>
          ))}
        </ul>
        <p class="svc-note mt-8">{s.prepare.note}</p>
      </div>
      <div class="lg:sticky lg:top-28">
        <figure class="pframe" data-reveal style="--d:.12s">
          <span class="pframe-line" aria-hidden="true"></span>
          <div class="pframe-img">
            <img src={photo3.src} alt={photo3.alt} width="1400" height="1400" loading="lazy" class="kb h-full w-full object-cover object-[62%_50%]" />
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-plum-800/35 via-transparent to-magenta-500/10 mix-blend-multiply"></div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="section" aria-labelledby="more-h">
    <Backdrop variant="blush" mark="none" />
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Our services</p>
        <h2 id="more-h" class="h-section">Other services</h2>
      </div>
      <ul class="mt-12 grid border-t border-plum-700/15 sm:grid-cols-2 sm:gap-x-12 lg:grid-cols-3" data-reveal>
        {others.map((c) => (
          <li><a href={c.href} class="mlink"><span>{c.label}</span><svg aria-hidden="true" viewBox="0 0 14 10" class="h-2.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 5h11M8 1l4 4-4 4" /></svg></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="section on-dark !py-20" aria-labelledby="cta-h">
    <Backdrop variant="plum" mark="left" />
    <div class="wrap grid items-center gap-10 lg:grid-cols-[1fr_auto]">
      <div data-reveal>
        <p class="eyebrow">Visit us</p>
        <h2 id="cta-h" class="h-section text-white">Schedule your appointment</h2>
        <p class="lede mt-5 max-w-2xl">{s.prepare.closing}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4" data-reveal style="--d:.12s">
        <a href={site.portalUrl} class="btn-appt" rel="noopener" target="_blank">Request appointment</a>
        <a href={site.phoneHref} class="btn">Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
)}
