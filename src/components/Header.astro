---
import { nav, site } from '../data/site';
import MobileMenu from './islands/MobileMenu';
---
<header data-header class="group/h fixed inset-x-0 top-0 z-50">
  <!-- Utility strip -->
  <div class="hidden bg-ink text-[.72rem] tracking-[.08em] text-white/80 md:block">
    <div class="wrap flex items-center justify-between py-2">
      <p class="flex items-center gap-5">
        <span>{site.address.line1}, {site.address.city}</span>
        <span class="text-white/30">|</span>
        <span>{site.hours}</span>
      </p>
      <p class="flex items-center gap-5">
        <a class="hover:text-rose-200" href={site.phoneHref}>Call {site.phone}</a>
        <a class="hover:text-rose-200" href={site.portalUrl} rel="noopener" target="_blank">Patient portal</a>
      </p>
    </div>
  </div>

  <!-- Main bar: glass, deepens on scroll -->
  <div class="border-b border-plum-700/10 bg-white/80 backdrop-blur-xl transition-[background-color,box-shadow] duration-500 group-data-[scrolled]/h:bg-white/95 group-data-[scrolled]/h:shadow-[0_14px_40px_-24px_rgb(58_16_56/.55)]">
    <div class="wrap flex items-center justify-between gap-6 py-3">
      <a href="/" class="group/logo block shrink-0" aria-label={`${site.name} — home`}>
        <img src="/images/Logo.png" alt={site.name} width="600" height="145"
          class="h-12 w-auto transition-transform duration-500 group-hover/logo:-translate-y-0.5 md:h-[3.75rem]" />
      </a>
      <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
        {nav.map((i) => <a class="nav-link" href={i.href}>{i.label}</a>)}
      </nav>
      <div class="flex items-center gap-3">
        <a href={site.appointmentHref} class="btn-appt hidden sm:inline-flex">Request appointment</a>
        <MobileMenu client:media="(max-width: 1023px)" items={nav} phone={site.phone} phoneHref={site.phoneHref} />
      </div>
    </div>
  </div>
</header>
