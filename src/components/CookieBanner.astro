---
// Cookie banner. Plain HTML + a small script (no React). Same choices, same storage as before:
// localStorage key + version from src/data/cookies.ts, window.cookieConsent, "cookie-consent" and
// "open-cookie-settings" events. The markup is in the page but hidden until the script shows it.
import { cookieConsent } from '../data/cookies';
const { storageKey, version, intro, policyHref, categories } = cookieConsent;
---
<div class="ck" data-ck data-key={storageKey} data-version={version} tabindex="-1" role="dialog" aria-modal="false" aria-labelledby="ck-h" hidden>
  <h2 id="ck-h">Cookie settings</h2>
  <p>{intro} <a href={policyHref} class="svc-link">Read our Privacy Policy</a>.</p>
  <ul class="ck-list" data-ck-list hidden>
    {categories.map((c) => (
      <li class="ck-item">
        <strong id={`ck-${c.key}`}>{c.label}</strong>
        <button type="button" role="switch" data-cat={c.key} aria-checked={c.locked ? 'true' : 'false'} aria-labelledby={`ck-${c.key}`} disabled={c.locked} class="ck-sw"></button>
        <span class="d">{c.text}</span>
      </li>
    ))}
  </ul>
  <div class="ck-actions">
    <button type="button" class="ck-btn ck-btn-main" data-ck-all>Accept all</button>
    <button type="button" class="ck-btn" data-ck-none>Reject optional</button>
    <button type="button" class="ck-btn" data-ck-custom>Customize</button>
    <button type="button" class="ck-btn" data-ck-save hidden>Save choices</button>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-ck]');
  if (box) {
    const key = box.dataset.key as string;
    const version = Number(box.dataset.version);
    const list = box.querySelector<HTMLElement>('[data-ck-list]')!;
    const sw = Array.from(box.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const bCustom = box.querySelector<HTMLElement>('[data-ck-custom]')!;
    const bSave = box.querySelector<HTMLElement>('[data-ck-save]')!;
    type Choice = Record<string, boolean>;
    const w = window as unknown as { cookieConsent?: Choice };
    const defaults = (): Choice => Object.fromEntries(sw.map((s) => [s.dataset.cat!, s.disabled]));
    const all = (on: boolean): Choice => Object.fromEntries(sw.map((s) => [s.dataset.cat!, s.disabled || on]));
    const read = (): Choice | null => {
      try {
        const raw = localStorage.getItem(key);
        if (!raw) return null;
        const v = JSON.parse(raw);
        return v && v.version === version ? v.choice : null;
      } catch { return null; }
    };
    const show = (choice: Choice) => sw.forEach((s) => s.setAttribute('aria-checked', String(!!choice[s.dataset.cat!])));
    const current = (): Choice => Object.fromEntries(sw.map((s) => [s.dataset.cat!, s.getAttribute('aria-checked') === 'true']));
    const custom = (on: boolean) => {
      list.hidden = !on; bCustom.hidden = on; bSave.hidden = !on;
      box.focus({ preventScroll: true });
    };
    const open = (isCustom: boolean) => { box.hidden = false; custom(isCustom); };
    const save = (c: Choice) => {
      try { localStorage.setItem(key, JSON.stringify({ version, choice: c, at: new Date().toISOString() })); } catch { /* storage blocked */ }
      w.cookieConsent = c;
      window.dispatchEvent(new CustomEvent('cookie-consent', { detail: c }));
      box.hidden = true; list.hidden = true; bCustom.hidden = false; bSave.hidden = true;
    };

    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const s = t.closest<HTMLButtonElement>('[data-cat]');
      if (s && !s.disabled) s.setAttribute('aria-checked', String(s.getAttribute('aria-checked') !== 'true'));
      else if (t.closest('[data-ck-all]')) save(all(true));
      else if (t.closest('[data-ck-none]')) save(all(false));
      else if (t.closest('[data-ck-custom]')) custom(true);
      else if (t.closest('[data-ck-save]')) save(current());
    });
    box.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !list.hidden) custom(false); });
    window.addEventListener('open-cookie-settings', () => { show({ ...defaults(), ...(read() || {}) }); open(true); });

    const saved = read();
    show({ ...defaults(), ...(saved || {}) });
    if (saved) w.cookieConsent = saved;
    else {
      // Show the banner only after the web fonts are ready (at most 2.5 s), so its text cannot reflow and
      // move the box after it is on screen (this caused CLS). It is position:fixed, so it never moves other content.
      const fonts = document.fonts && document.fonts.ready ? Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 2500))]) : Promise.resolve();
      fonts.then(() => ('requestIdleCallback' in window ? requestIdleCallback(() => open(false), { timeout: 1000 }) : setTimeout(() => open(false), 100)));
    }
  }
</script>
