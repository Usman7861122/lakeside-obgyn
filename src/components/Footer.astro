---
import Backdrop from './ui/Backdrop.astro';
import { site, nav } from '../data/site';
---
<footer class="section on-dark !pb-10 !pt-20" aria-label="Site footer">
  <Backdrop variant="plum" mark="none" />
  <div class="wrap">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <img src="/images/Logo.png" alt={site.name} width="600" height="145" loading="lazy" class="h-14 w-auto brightness-0 invert" />
        <p class="mt-6 max-w-xs font-display text-2xl leading-snug text-white">{site.tagline}</p>
      </div>
      <div>
        <h3 class="text-[.72rem] font-semibold uppercase tracking-[.24em] text-rose-200 !font-sans">Office</h3>
        <address class="mt-4 not-italic leading-relaxed text-white/85">
          {site.address.line1}<br />{site.address.city}, {site.address.state} {site.address.zip}
        </address>
        <p class="mt-3 text-white/85">{site.hours}</p>
      </div>
      <div>
        <h3 class="text-[.72rem] font-semibold uppercase tracking-[.24em] text-rose-200 !font-sans">Contact</h3>
        <p class="mt-4"><a href={site.phoneHref} class="text-white/90 no-underline hover:text-rose-200">{site.phone}</a></p>
        <p class="mt-3"><a href={site.portalUrl} rel="noopener" target="_blank" class="text-white/90 no-underline hover:text-rose-200">Patient portal</a></p>
        <p class="mt-3"><a href={site.social.facebook} rel="noopener" target="_blank" class="text-white/90 no-underline hover:text-rose-200">Facebook</a></p>
      </div>
      <div>
        <h3 class="text-[.72rem] font-semibold uppercase tracking-[.24em] text-rose-200 !font-sans">Explore</h3>
        <ul class="mt-4 space-y-3">
          {nav.map((n) => <li><a href={n.href} class="text-white/90 no-underline hover:text-rose-200">{n.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-3 border-t border-white/15 pt-6 text-xs leading-relaxed text-white/60 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <p class="max-w-2xl">
        Open Payments notice (California AB 1278): the Open Payments database is a federal tool used to search payments made by drug and device companies to physicians and teaching hospitals. It can be found at
        <a class="text-rose-200 underline" href="https://openpaymentsdata.cms.gov" rel="noopener" target="_blank">openpaymentsdata.cms.gov</a>.
      </p>
    </div>
  </div>
</footer>
