---
import Backdrop from '../ui/Backdrop.astro';
import { site } from '../../data/site';
import { portalFeatures } from '../../data/home';
---
<section id="portal" class="section on-dark relative isolate overflow-hidden" aria-labelledby="portal-h">
  <div aria-hidden="true" class="parallax-bg" style="--bg:url('/images/portal/bg.jpg')"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-plum-900/90 via-plum-900/70 to-plum-800/50"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/50 via-transparent to-ink/30"></div>
  <div class="wrap">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Patient portal</p>
      <h2 id="portal-h" class="h-section text-white">Your health information, open any time</h2>
      <p class="lede mt-6">Use the secure patient portal, day or night, to stay in touch with our office and keep track of your care.</p>
      <ul class="mt-8 space-y-3">
        {portalFeatures.map((f) => (
          <li class="flex items-center gap-4 text-white/95">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0 text-rose-200"><path d="m3 9.5 4 4 8-9" /></svg>{f}
          </li>
        ))}
      </ul>
      <div class="mt-10"><a href={site.portalUrl} class="btn-appt" rel="noopener" target="_blank">Open the patient portal</a></div>
    </div>
  </div>
</section>
