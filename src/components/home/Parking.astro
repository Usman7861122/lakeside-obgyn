---
import Backdrop from '../ui/Backdrop.astro';
import { site } from '../../data/site';
---
<section id="visit" class="section" aria-labelledby="visit-h">
  <Backdrop variant="mist" mark="none" />
  <div class="wrap grid items-center gap-14 lg:grid-cols-2 lg:gap-24">
    <div data-reveal>
      <p class="eyebrow">Visit us</p>
      <h2 id="visit-h" class="h-section">Parking information</h2>
      <!-- Text copied from Parking Information.docx (typo "start" corrected to "star") -->
      <p class="lede mt-6">If you are driving to our 402 8th Avenue office, please allow enough time to secure parking (red star on the map).</p>
      <p class="lede mt-4">There is a meter parking lot located on 8th Avenue between Geary Blvd and Clement Street (red square on the map). You may also find meter parking on 8th Avenue in front of the office building and on Geary Blvd, or nearby neighborhood street parking if available.</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={site.mapsHref} class="btn-appt" rel="noopener" target="_blank">Get directions</a>
        <p class="text-sm text-ink/70">{site.address.line1}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
      </div>
    </div>

    <figure class="mx-auto w-full max-w-md" data-reveal style="--d:.14s">
      <div class="overflow-hidden rounded-[6px] bg-white shadow-[0_40px_80px_-44px_rgb(58_16_56/.6)]">
        <!-- Plays once when scrolled into view, muted, then stops on the last frame. -->
        <video id="parking-video" class="block aspect-[4/5] w-full" muted playsinline preload="metadata" poster="/images/parking/parking-poster.jpg" aria-label="Animated map showing the office, the meter parking lot on 8th Avenue, nearby street parking, and the short walk to 402 8th Avenue.">
          <source src="/images/parking/parking-demo.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="mt-4 flex justify-center">
        <button type="button" id="parking-replay" class="btn !h-11 !px-6 !text-[.72rem]" aria-controls="parking-video">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>Replay map
        </button>
      </div>
    </figure>
  </div>
</section>

<script>
  const v = document.getElementById('parking-video') as HTMLVideoElement | null;
  if (v) {
    document.getElementById('parking-replay')?.addEventListener('click', () => {
      v.currentTime = 0;
      v.play().catch(() => { v.controls = true; });
    });
    v.muted = true;
    v.loop = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      v.controls = true; // visitor chooses to play
    } else {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          v.play().catch(() => { v.controls = true; });
          io.disconnect();
        }
      }, { threshold: 0.5 });
      io.observe(v);
    }
  }
</script>
