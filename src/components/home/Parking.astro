---
import Backdrop from '../ui/Backdrop.astro';
import { site } from '../../data/site';
---
<section id="visit" class="section" aria-labelledby="visit-h">
  <Backdrop variant="mist" mark="none" />
  <div class="wrap grid items-center gap-14 lg:grid-cols-2 lg:gap-24">
    <div data-reveal>
      <p class="eyebrow">Visit us</p>
      <h2 id="visit-h" class="h-section">Parking information</h2>
      <!-- Text copied from Parking Information.docx (typo "start" corrected to "star") -->
      <p class="lede mt-6">If you are driving to our 402 8th Avenue office, please allow enough time to secure parking (red star on the map).</p>
      <p class="lede mt-4">There is a meter parking lot located on 8th Avenue between Geary Blvd and Clement Street (red square on the map). You may also find meter parking on 8th Avenue in front of the office building and on Geary Blvd, or nearby neighborhood street parking if available.</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={site.mapsHref} class="btn-appt" rel="noopener" target="_blank">Get directions</a>
        <p class="text-sm text-ink/70">{site.address.line1}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
      </div>
    </div>

    <figure class="mx-auto w-full max-w-md" data-reveal style="--d:.14s">
      <svg viewBox="0 0 480 540" role="img" aria-label="Simple map: 8th Avenue runs north to south between Clement Street at the top and Geary Boulevard below. A meter parking lot is on the east side of 8th Avenue near Clement Street. The office star is just south of Geary Boulevard." class="w-full rounded-[6px] bg-white shadow-[0_40px_80px_-44px_rgb(58_16_56/.6)]">
        <rect width="480" height="540" fill="#fbf7fc" />
        <!-- blocks -->
        <g fill="#efe4f2">
          <rect x="20" y="96" width="156" height="310" rx="4" /><rect x="224" y="96" width="236" height="310" rx="4" />
          <rect x="224" y="466" width="236" height="60" rx="4" /><rect x="20" y="466" width="156" height="60" rx="4" />
        </g>
        <!-- park / church block -->
        <rect x="40" y="250" width="116" height="120" rx="4" fill="#e1eddc" />
        <!-- streets -->
        <g fill="#ffffff" stroke="#dcc8e0" stroke-width="1">
          <rect x="176" y="0" width="48" height="540" />
          <rect x="0" y="46" width="480" height="40" />
          <rect x="0" y="410" width="480" height="48" />
        </g>
        <g fill="#8a6a86" font-family="Open Sans Variable, Open Sans, sans-serif" font-size="12" letter-spacing="2">
          <text x="300" y="71">CLEMENT ST</text>
          <text x="40" y="439">GEARY BLVD</text>
          <text transform="translate(205 300) rotate(-90)" text-anchor="middle">8TH AVE</text>
        </g>
        <!-- meter lot (red square) -->
        <rect x="236" y="110" width="110" height="58" fill="rgb(216 16 112 / .08)" stroke="#d81070" stroke-width="2" rx="2" />
        <circle cx="291" cy="139" r="13" fill="#882078" /><text x="291" y="144" text-anchor="middle" fill="#fff" font-size="15" font-weight="700" font-family="Open Sans Variable, sans-serif">P</text>
        <!-- street meter parking -->
        <g stroke="#882078" stroke-width="3" stroke-dasharray="2 7" stroke-linecap="round" opacity=".7">
          <path d="M216 190 V396" /><path d="M236 424 H452" />
        </g>
        <!-- office (red star) -->
        <path transform="translate(232 486) scale(1.5)" d="M0-14 4.1-4.3 14.5-3.6 6.6 3.2 9 13.4 0 8 -9 13.4 -6.6 3.2 -14.5-3.6 -4.1-4.3Z" fill="#d81070" />
        <g font-family="Open Sans Variable, sans-serif" font-size="12" fill="#3a1038" font-weight="600">
          <text x="262" y="474">Our office</text><text x="262" y="490" font-weight="400" fill="#6b4a68">402 8th Ave, Suite 201</text>
          <text x="358" y="143">Meter lot</text>
        </g>
      </svg>
      <figcaption class="mt-3 text-xs text-ink/55">Simple map, not to scale. Red star: office. Red square: meter lot. Dotted lines: meter parking.</figcaption>
    </figure>
  </div>
</section>
