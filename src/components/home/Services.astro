---
import Backdrop from '../ui/Backdrop.astro';
import Img from '../ui/Img.astro';
import { services } from '../../data/home';
import { servicesMenu } from '../../data/nav';
const more = [
  { label: 'Birth control', href: '/services/birth-control/' },
  { label: 'Abnormal Pap smear', href: '/services/abnormal-pap-smear/' },
  { label: 'Ovarian cyst care', href: '/services/ovarian-cyst/' },
  { label: 'Irregular bleeding', href: '/services/irregular-bleeding/' },
  { label: 'PCOS / PMOS care', href: '/services/polycystic-ovary-syndrome/' },
  { label: 'Pelvic pain care', href: '/services/pelvic-pain/' },
  { label: 'Ultrasound', href: '/services/ultrasound/' },
  { label: 'Weight loss and management', href: '/services/weight-loss-management/' },
  { label: 'Sexual health and sexual pain', href: '/services/sexual-health/' },
  { label: 'The Sonata® procedure', href: '/services/sonata/' },
];
// Every page in the Services menu must show up here, as a card above or a chip below.
// If a new service page is added to the menu and not placed here, the build stops with this message.
const shown = new Set([...services.map((s) => s.href), ...more.map((m) => m.href)]);
const left = servicesMenu.filter((m) => !shown.has(m.href)).map((m) => m.label);
if (left.length) throw new Error(`Home "Our services" is missing: ${left.join(', ')}. Add a card (src/data/home.ts) or a chip (src/components/home/Services.astro).`);
---
<section id="services" class="section on-dark" aria-labelledby="services-h">
  <Backdrop variant="plum" mark="left" rings={2} />
  <div class="wrap">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Our services</p>
      <h2 id="services-h" class="h-section text-white">Care for every stage, <span class="shift">in one place</span></h2>
      <p class="lede mt-5">Hover or tap a card to see more.</p>
    </div>
    <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, n) => (
        <li data-reveal style={`--d:${(n % 3) * 0.1}s`}>
          <div class="flip aspect-square cursor-pointer" tabindex="0" role="group" aria-label={s.title}>
            <div class="flip-inner">
              <div class="flip-face">
                <Img src={s.img} alt="" tone={s.tone} sizes="(min-width:1280px) 389px, (min-width:1024px) 30vw, (min-width:640px) 44vw, calc(100vw - 3rem)" class="h-full" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-plum-900/25 to-plum-800/20"></div>
                <h3 class="absolute inset-x-0 bottom-0 p-6 text-2xl leading-tight text-white">{s.title}</h3>
              </div>
              <div class="flip-face flip-back grid content-center bg-plum-800 p-8 text-white">
                <Img src={s.img} alt="" decorative tone={s.tone} sizes="(min-width:1280px) 389px, (min-width:1024px) 30vw, (min-width:640px) 44vw, calc(100vw - 3rem)" class="absolute inset-0 h-full w-full" />
                <div aria-hidden="true" class="absolute inset-0 bg-plum-900/[.82] mix-blend-multiply"></div>
                <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/70 via-plum-800/70 to-plum-700/60"></div>
                <span aria-hidden="true" class="absolute -right-6 -top-4 h-28 w-48 opacity-15" style="background:#fff;-webkit-mask:url('/images/logo-mark.webp') center/contain no-repeat;mask:url('/images/logo-mark.webp') center/contain no-repeat"></span>
                <h3 class="relative text-2xl text-rose-200">{s.title}</h3>
                <p class="relative mt-4 leading-relaxed text-white">{s.text}</p>
                <a href={s.href} class="relative mt-6 inline-flex w-fit items-center gap-2 text-xs font-semibold uppercase tracking-[.18em] text-white underline-offset-8 hover:underline">Learn more<span class="sr-only"> about {s.title}</span></a>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-16 text-center" data-reveal>
      <p class="eyebrow">More care we offer</p>
      <ul class="mx-auto mt-6 flex max-w-4xl flex-wrap justify-center gap-3">
        {more.map((m) => (
          <li><a href={m.href} class="more-chip">{m.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="mt-8 flex justify-center" data-reveal>
      <a href="/services/" class="btn-appt">View all services</a>
    </div>
  </div>
</section>
