---
import Backdrop from '../ui/Backdrop.astro';
import { site } from '../../data/site';
const q = encodeURIComponent(`${site.address.line1}, ${site.address.city}, ${site.address.state} ${site.address.zip}`);
const mapSrc = `https://www.google.com/maps?q=${q}&z=16&output=embed`;
const dirHref = `https://www.google.com/maps/dir/?api=1&destination=${q}`;
---
<section id="contact" class="section on-dark" aria-labelledby="contact-h">
  <Backdrop variant="plum" mark="none" />
  <div class="wrap">
    <div class="overflow-hidden rounded-[6px] bg-white/[.05] ring-1 ring-white/15 backdrop-blur-sm" data-reveal>
      <div class="grid lg:grid-cols-[5fr_6fr]">
        <div class="flex flex-col p-8 md:p-12">
          <p class="eyebrow">Get in touch</p>
          <h2 id="contact-h" class="h-section text-white">Request an appointment</h2>
          <p class="lede mt-5">Call us, or send a message and our team will reply. This form is for scheduling and general questions only.</p>
          <dl class="mt-auto pt-10">
            <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-4 border-t border-white/15 py-5">
              <dt class="text-[.72rem] font-semibold uppercase tracking-[.22em] text-rose-200">Phone</dt>
              <dd class="font-display text-2xl"><a href={site.phoneHref} class="text-white no-underline hover:text-rose-200">{site.phone}</a></dd>
            </div>
            <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-4 border-t border-white/15 py-5">
              <dt class="text-[.72rem] font-semibold uppercase tracking-[.22em] text-rose-200">Office</dt>
              <dd class="text-white/90">{site.address.line1}<br />{site.address.city}, {site.address.state} {site.address.zip}</dd>
            </div>
            <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-4 border-y border-white/15 py-5">
              <dt class="text-[.72rem] font-semibold uppercase tracking-[.22em] text-rose-200">Hours</dt>
              <dd class="text-white/90">{site.hours}</dd>
            </div>
          </dl>
        </div>
        <form class="flex flex-col bg-white/[.07] p-8 md:p-12 lg:border-l lg:border-white/15" action="#" method="post">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-[.8rem] font-semibold uppercase tracking-[.16em] text-rose-200">Full name
              <input name="name" required autocomplete="name" class="field h-12" />
            </label>
            <label class="grid gap-2 text-[.8rem] font-semibold uppercase tracking-[.16em] text-rose-200">Phone
              <input name="phone" type="tel" required autocomplete="tel" class="field h-12" />
            </label>
          </div>
          <label class="mt-5 grid gap-2 text-[.8rem] font-semibold uppercase tracking-[.16em] text-rose-200">Email
            <input name="email" type="email" required autocomplete="email" class="field h-12" />
          </label>
          <label class="mt-5 flex flex-1 flex-col gap-2 text-[.8rem] font-semibold uppercase tracking-[.16em] text-rose-200">How can we help?
            <textarea name="message" rows="5" class="field min-h-32 flex-1 py-3"></textarea>
          </label>
          <p class="mt-4 text-xs leading-relaxed text-white/65">Please do not include medical details in this form. For an emergency, call 911.</p>
          <div class="mt-6"><button type="submit" class="btn-appt">Send request</button></div>
        </form>
      </div>
      <div class="relative border-t border-white/15">
        <iframe title="Map of Lakeside Obstetrics, Gynecology & Fertility, 402 8th Avenue, San Francisco" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="block h-72 w-full md:h-80" style="filter:grayscale(.55) contrast(1.05) brightness(.95)"></iframe>
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-plum-700/30 mix-blend-color"></div>
        <a href={dirHref} target="_blank" rel="noopener" class="absolute bottom-4 left-4 rounded-[3px] bg-plum-900/90 px-4 py-2 text-[.7rem] font-semibold uppercase tracking-[.18em] text-white no-underline backdrop-blur hover:bg-plum-700">Get directions</a>
      </div>
    </div>
  </div>
</section>
